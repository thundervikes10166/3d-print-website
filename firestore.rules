rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isTeacher() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher','teacher_admin'];
    }
    function approvedStudent() {
      return signedIn() &&
        exists(/databases/$(database)/documents/class_students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/class_students/$(request.auth.uid)).data.approved == true &&
        get(/databases/$(database)/documents/class_students/$(request.auth.uid)).data.canPublish == true;
    }
    function operator() { return isAdmin() || isTeacher() || approvedStudent(); }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'student' &&
        request.resource.data.email == request.auth.token.email;
      // Profile edits cannot change authorization fields, even by a signed-in buyer.
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName','bio','specialty','printerHardware','gradeClass'
        ]));
      allow delete: if isAdmin();
    }

    match /class_student_applications/{userId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly(['uid','email','name','status','createdAt']);
      allow update, delete: if isAdmin();
    }

    match /class_students/{studentId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == studentId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'published' || operator() ||
        (signedIn() && resource.data.creatorId == request.auth.uid);
      allow create: if operator() && request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.status in ['published','draft'];
      allow update, delete: if operator();
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (operator() || resource.data.requesterId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.requesterId == request.auth.uid &&
        request.resource.data.status == 'submitted' &&
        request.resource.data.quantity >= 1 && request.resource.data.quantity <= 1000;
      // Staff can edit customer-request details and workflow state, but not owner IDs.
      allow update: if operator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'itemTitle','description','quantity','desiredSize','desiredDimensions',
        'material','color','colorMode','neededByDate','estimatedCost',
        'contactEmail','contactPhone','pickupLocation',
        'status','statusLog','editLog','updatedAt','assignedMakerId','assignedMakerName'
      ]);
      allow delete: if isAdmin();
      match /staffNotes/{noteId} {
        allow read: if operator();
        allow create: if operator() && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (operator() || resource.data.buyerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.status == 'requested' &&
        request.resource.data.quantity >= 1 && request.resource.data.quantity <= 1000;
      // Buyers may view their order but may not change production/payment state.
      allow update: if operator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'quantity','selectedColor','selectedMaterial','notes','pickupLocation',
        'contactEmail','contactPhone','status','statusLog','editLog','updatedAt',
        'depositPaid','depositAmount','depositTransactionId','depositPaidAt'
      ]) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'depositPaid','depositAmount','depositTransactionId','depositPaidAt'
      ]) || isAdmin());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if operator();
    }
    match /inventory/{itemId} {
      allow read: if true;
      allow write: if operator();
    }
    match /admin_whitelist/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
